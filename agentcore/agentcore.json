{
  "name": "GoodNeighbor",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "Project": "agents-for-humans",
    "Purpose": "HackathonDevelopment"
  },
  "runtimes": [
    {
      "name": "good_neighbor_runtime",
      "description": "Bounded surplus-food capacity-drop recovery demonstration",
      "build": "Container",
      "entrypoint": "src/good_neighbor/agentcore_app.py",
      "codeLocation": ".",
