      "dockerfile": "infrastructure/agentcore/Dockerfile",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "instrumentation": {
        "enableOtel": false
      },
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 300,
        "maxLifetime": 900
      },
      "tags": {
        "Project": "agents-for-humans",
        "Purpose": "HackathonDevelopment"
      }
    }
  ],
